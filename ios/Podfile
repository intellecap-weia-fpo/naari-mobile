platform :ios, '15.0'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

# Locate Flutter
def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  if File.exist?(generated_xcode_build_settings_path)
    File.foreach(generated_xcode_build_settings_path) do |line|
      match = line.match(/FLUTTER_ROOT\=(.*)/)
      return match[1].strip if match
    end
  end
  # Fallback to environment variable
  env_root = ENV['FLUTTER_ROOT']
  return env_root.strip if env_root && !env_root.empty?
  # Fallback to flutter binary location
  flutter_bin = `which flutter`.strip
  unless flutter_bin.empty?
    return File.expand_path(File.join(File.dirname(flutter_bin), '..'))
  end
  raise "FLUTTER_ROOT could not be resolved. Ensure Flutter is installed, run 'flutter pub get' first, or set FLUTTER_ROOT."
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks! :linkage => :static
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    # Call Flutter's helper with the target (not the installer)
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      # permission_handler iOS permission switches. Enable only what you need.
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'PERMISSION_MICROPHONE=1',
        'PERMISSION_CAMERA=1',
        'PERMISSION_PHOTOS=1',
        'PERMISSION_SPEECH_RECOGNIZER=0',
        'PERMISSION_MEDIA_LIBRARY=0',
      ]

      # Xcode 27 no longer supports deployment targets below iOS 15.
      if config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 15.0
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      end
    end
  end
end
